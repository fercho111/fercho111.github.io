  author       = {Gómez-Bedoya, José F. and
                  Restrepo Arango, Ricardo L.},
  title        = {Asymmetric AlGaAs/GaAs Quantum Wells in a
                   Dielectric Environment: Electric-Field-Tunable
                   Optical Properties
                  },
  month        = dec,
  year         = 2025,
  publisher    = {Zenodo},
